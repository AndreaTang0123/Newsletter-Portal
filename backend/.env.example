# Database Configuration
# For local development (SQLite):
DATABASE_URL=sqlite:///./newsletter.db

# For future Azure SQL migration, use connection string like:
# DATABASE_URL=mssql+pyodbc://user:password@server.database.windows.net:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server

# Frontend Configuration
FRONTEND_BASE_URL=http://localhost:5173

# Backend Configuration
BACKEND_BASE_URL=http://localhost:8000

# JWT & Authentication
SECRET_KEY=yoursecretkeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email configurations (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sender@company.com
SMTP_PASSWORD=password

# AI configuration
GEMINI_API_KEY=api_key
